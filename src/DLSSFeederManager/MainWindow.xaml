<Window x:Class="DLSSFeederManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DLSS Feeder Manager"
        Width="860"
        Height="820"
        MinWidth="760"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid x:Name="ContentPanel" Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,14">
        <TextBlock FontSize="26" FontWeight="SemiBold" Text="DLSS Feeder Manager" />
        <TextBlock Margin="0,4,0,0"
                   Foreground="DimGray"
                   TextWrapping="Wrap"
                   Text="Current build: 64-bit D3D11/D3D12 only. Native D3D9, D3D10, Vulkan, and 32-bit paths are not installed." />
      </StackPanel>

      <GroupBox Grid.Row="1" Header="1. Select game" Padding="10" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBox x:Name="GameBox" Grid.Row="0" Grid.Column="0" IsReadOnly="True" />
          <Button Grid.Row="0" Grid.Column="1" Content="Browse" Click="BrowseGame_Click" />
          <TextBlock x:Name="ProfileText"
                     Grid.Row="1"
                     Grid.ColumnSpan="2"
                     Margin="5,6,5,2"
                     FontWeight="SemiBold"
                     Text="No game selected" />
        </Grid>
      </GroupBox>

      <GroupBox Grid.Row="2" Header="2. Select required components" Padding="10" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center" Text="RenoDX DLSS 5 add-on" />
          <TextBox x:Name="RenoDxBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" />
          <Button Grid.Row="0" Grid.Column="2" Content="Browse" Click="BrowseRenoDx_Click" />

          <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center" Text="nvngx_dlss.dll" />
          <TextBox x:Name="DlssBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" />
          <Button Grid.Row="1" Grid.Column="2" Content="Browse" Click="BrowseDlss_Click" />

          <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Center" Text="nvngx_dlssnr.dll" />
          <TextBox x:Name="DlssNrBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" />
          <Button Grid.Row="2" Grid.Column="2" Content="Browse" Click="BrowseDlssNr_Click" />

          <TextBlock Grid.Row="3" Grid.Column="0" Margin="5" VerticalAlignment="Center" Text="iMMERSE LaunchPad (required)" />
          <TextBox x:Name="ImmerseBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True" />
          <Button Grid.Row="3" Grid.Column="2" Content="Browse" Click="BrowseImmerse_Click" />

          <TextBlock Grid.Row="4"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Margin="5,2,5,5"
                     Foreground="DimGray"
                     TextWrapping="Wrap"
                     Text="Select the downloaded ZIP or usually: iMMERSE-main\Shaders\MartysMods_LAUNCHPAD.fx" />

          <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Download iMMERSE" Click="OpenImmerse_Click" />
            <Button Content="Get RenoDX / DLSS NR (RHI)" Click="OpenRhi_Click" />
            <Button Content="Open DLSS Swapper" Click="OpenDlssSwapper_Click" />
          </StackPanel>

          <TextBlock Grid.Row="6"
                     Grid.ColumnSpan="3"
                     Margin="5,7,5,0"
                     Foreground="DimGray"
                     TextWrapping="Wrap"
                     Text="RHI supplies the RenoDX DLSS 5 add-on and can deploy nvngx_dlssnr.dll. The selected add-on filename is preserved." />

          <TextBlock Grid.Row="7"
                     Grid.ColumnSpan="3"
                     Margin="5,3,5,2"
                     Foreground="DimGray"
                     TextWrapping="Wrap"
                     Text="DLSS5-Feeder is downloaded from its official release. ReShade, iMMERSE, RenoDX, and NVIDIA runtime files are not bundled. Close the game before Install or Remove. The manager does not request administrator rights." />
        </Grid>
      </GroupBox>

      <StackPanel x:Name="ActionPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="3. Check and apply" />
        <Button Content="Check" Click="Check_Click" />
        <Button Content="Install" Click="Install_Click" />
        <Button Content="Validate" Click="Validate_Click" />
        <Button Content="Remove" Click="Remove_Click" />
      </StackPanel>

      <GroupBox Grid.Row="4" Header="Result and next steps" Padding="10" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" Text="Ready" />
          <TextBox x:Name="StatusBox"
                   Margin="0,8,0,0"
                   MinHeight="120"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" />
        </StackPanel>
      </GroupBox>

      <Button Grid.Row="5"
              HorizontalAlignment="Right"
              Content="Open project on GitHub"
              Click="OpenProject_Click" />
    </Grid>
  </ScrollViewer>
</Window>
